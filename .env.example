# Where the Go backend listens (see README.MD). No trailing slash needed.
GO_API_URL=http://localhost:8080

# Required in production. Signs the login cookie; if unset, a random key is
# generated at startup and everyone is logged out on every restart.
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0

# Optional
GO_API_TIMEOUT=10
SESSION_HOURS=24
PORT=5000
